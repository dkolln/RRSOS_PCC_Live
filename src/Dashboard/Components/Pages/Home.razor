@page "/"
@implements IDisposable
@inject LiveFileService Live
@inject PCLauncherService Launcher
@inject WorldFileService World

@{
    var data = Live.Data;
    var status = Live.Status;
    var player = data?.Player;
    var vehicle = data?.Vehicle;
    var running = Launcher.IsRunning();
    var dim = status != LiveStatus.Live;
    var world = World.Data;
    var extractors = world?.Extractors ?? new List<ExtractorData>();
    var flying = data?.Drones?.Flying ?? new List<DroneData>();
    var stations = world?.DroneStations ?? new List<DroneStationData>();
    var recentlyDocked = _recentlyDocked.Values.Select(v => v.Drone).ToList();
}

<div class="app">

    <header class="topbar">
        <div class="brand">RRSOS PCC <span>LIVE</span></div>

        <div class="status status-@status.ToString().ToLowerInvariant()">
            <span class="dot">●</span>
            <span class="status-text">@StatusText(status, data, running)</span>
            <span class="status-sub">@StatusSub(status, data, running)</span>
        </div>

        <div class="spacer"></div>

        <button class="launch" disabled="@running" @onclick="LaunchGame"
                title="@(running ? "Planet Crafter is already running" : "Start Planet Crafter through Steam")">
            @(running ? "PLANET CRAFTER RUNNING" : "LAUNCH PC")
        </button>
    </header>

    <main class="grid">

        @* ── Column 1: Player (full height) ── *@
        <div class="col">
            <section class="card card-player">
                <h2>Player <span class="who">@player?.Name</span></h2>

                @if (player is null)
                {
                    <div class="empty">@EmptyText(status)</div>
                }
                else
                {
                    @if (player.Position is { } position)
                    {
                        @* Nav row: compass | altimeter | base-map | drone-map | vehicle-map *@
                        <NavDisplay Position="@(new Vector3((float)position.X, (float)position.Y, (float)position.Z))"
                                    Heading="@Compass.HeadingFromYaw(player.YawDegrees)" ShowPosition="false">
                            <Extra>
                                <BaseMap Bases="@_views" PlayerFlat="@_playerFlat"
                                         PlayerHeading="@Compass.HeadingFromYaw(player.YawDegrees)"
                                         SelectedId="@_selectedBaseId" PinnedId="@_pinnedBaseId"
                                         Open="@(_activeMap == "base")"
                                         OnMapClick="OnBaseMapClick" OnSelect="SelectBase"
                                         Dim="@dim" EmptyText="no bases" />
                            </Extra>
                            <Extra2>
                                <DroneMap Flying="@flying" Stations="@stations" PlayerFlat="@_playerFlat"
                                          PlayerHeading="@Compass.HeadingFromYaw(player.YawDegrees)"
                                          Open="@(_activeMap == "drone")" OnToggle='() => SelectMap("drone")'
                                          Dim="@dim" />
                            </Extra2>
                            <Extra3>
                                @if (vehicle != null)
                                {
                                    var vFlat = vehicle.Position is { } vp
                                        ? new Vector2((float)vp.X, (float)vp.Z)
                                        : _playerFlat;
                                    <div class="vehicle-mini @(_activeMap == "vehicle" ? "is-open" : "")"
                                         role="button" tabindex="0"
                                         title="@(vehicle.Position != null ? "Click to see vehicle" : "Vehicle stowed")"
                                         @onclick='() => SelectMap("vehicle")'>
                                        <RelativeMap PlayerFlat="@_playerFlat"
                                                     PlayerHeading="@Compass.HeadingFromYaw(player.YawDegrees)"
                                                     TargetFlat="@vFlat"
                                                     Known="@(vehicle.Position != null)" />
                                        <div class="nav-label">Vehicle</div>
                                        @if (vehicle.Position is null)
                                        {
                                            <div class="nav-caption">stowed</div>
                                        }
                                    </div>
                                }
                            </Extra3>
                        </NavDisplay>
                    }

                    <div class="vitals">
                        @if (player.Vitals is { } vitals)
                        {
                            <Gauge Label="Oxygen" Value="@Fraction(vitals.Oxygen, player.VitalsMax?.Oxygen, vitals.Oxygen)"
                                   MaxLabel="@Max(player.VitalsMax?.Oxygen ?? vitals.Oxygen)" WarnAt="0.5f" CritAt="0.2f" Unknown="@(vitals.Oxygen is null)" />
                            <Gauge Label="Health" Value="@Fraction(vitals.Health, player.VitalsMax?.Health, 100)"
                                   WarnAt="0.5f" CritAt="0.2f" Unknown="@(vitals.Health is null)" />
                            <Gauge Label="Thirst" Value="@Fraction(vitals.Thirst, player.VitalsMax?.Thirst, 100)"
                                   WarnAt="0.5f" CritAt="0.2f" Unknown="@(vitals.Thirst is null)" />
                            <Gauge Label="Toxicity" Value="@Fraction(vitals.Toxic, player.VitalsMax?.Toxic, 100)"
                                   HigherIsWorse="true" WarnAt="0.5f" CritAt="0.8f" Unknown="@(vitals.Toxic is null)" />
                        }
                    </div>

                    <div class="fill">
                        <ItemList Title="Backpack" Data="@player.Backpack" Columns="4" Dim="@dim" Collapsible="true" />
                    </div>

                    <ItemList Title="Gear" Data="@player.Equipment" Columns="3" Dim="@dim" Collapsible="true" />
                }
            </section>
        </div>

        @* ── Column 2: Planet + Power + Notes ── *@
        <div class="col">
            <section class="card card-planet">
                <h2>Planet <span class="who">@data?.PlanetId</span></h2>

                @if (data?.Planet is not { } planet)
                {
                    <div class="empty">@EmptyText(status)</div>
                }
                else
                {
                    <PlanetDials Data="@planet" Dim="@dim" />
                    <PowerCard Data="@planet.Power" Dim="@dim" />
                }
            </section>

            <section class="card card-notes">
                <h2>Notes</h2>
                <div class="fill">
                    <NotesList />
                </div>
            </section>
        </div>

        @* ── Column 3: Detail panel ── *@
        <div class="col">

            @* Small extractors chip — always visible, switches back to extractor list *@
            <div class="ext-bar">
                <button class="ext-link @(_activeMap == null ? "is-active" : "")"
                        @onclick="() => SelectMap(null)">
                    Extractors@(extractors.Count > 0 ? $" · {extractors.Count}" : "")
                </button>
            </div>

            @if (_activeMap == "base")
            {
                <section class="card card-detail">
                    <h2>Base <span class="who">@BaseCountText()</span></h2>
                    <BaseContents SelectedBase="@SelectedBase" IsPinned="@(_pinnedBaseId is not null)"
                                  OnFollowNearest="UnpinBase" Dim="@dim"
                                  EmptyText="@BasesEmptyText(status, world)" />
                </section>
            }
            else if (_activeMap == "drone")
            {
                <section class="card card-detail">
                    <h2>Drones <span class="who">@flying.Count flying, @stations.Sum(s => s.Docked) docked</span></h2>
                    <div class="scroll">
                        <DroneList Flying="@flying" RecentlyDocked="@recentlyDocked" Stations="@stations"
                                   PlayerFlat="@(player?.Position is not null ? _playerFlat : null)" Dim="@dim" />
                    </div>
                </section>
            }
            else if (_activeMap == "vehicle")
            {
                <section class="card card-detail">
                    <h2>Vehicle</h2>

                    @if (vehicle is null)
                    {
                        <div class="empty">@(data?.InWorld == true ? "No vehicle yet." : EmptyText(status))</div>
                    }
                    else
                    {
                        @if (vehicle.Position is { } vpos && player?.Position is not null)
                        {
                            var vFlat = new Vector2((float)vpos.X, (float)vpos.Z);
                            var dist  = (int)Vector2.Distance(_playerFlat, vFlat);
                            var dir   = Compass.GetCompassDirection(_playerFlat, vFlat);
                            <div class="vehicle-detail-map">
                                <RelativeMap PlayerFlat="@_playerFlat"
                                             PlayerHeading="@Compass.HeadingFromYaw(player.YawDegrees)"
                                             TargetFlat="@vFlat" Known="true" />
                                <div class="vehicle-detail-where">@dist m @dir</div>
                            </div>
                        }
                        else
                        {
                            <div class="empty vehicle-stowed">Stowed in pocket.</div>
                        }

                        <div class="fill">
                            <ItemList Title="Trunk" Data="@vehicle.Trunk" Columns="3" Dim="@dim" Collapsible="true" />
                        </div>
                        <ItemList Title="Gear" Data="@vehicle.Gear" Columns="3" Dim="@dim" Collapsible="true" />
                    }
                </section>
            }
            else
            {
                @* Default: extractors list *@
                <section class="card card-detail">
                    <h2>Extractors <span class="who">@(extractors.Count > 0 ? extractors.Count.ToString() : "")</span></h2>
                    <div class="scroll">
                        <ExtractorList Data="@extractors" PlayerFlat="@(player?.Position is not null ? _playerFlat : null)" Dim="@dim"
                                       EmptyText="@(world is null || !world.InWorld ? EmptyText(status) : "No extractors found.")" />
                    </div>
                </section>
            }
        </div>

    </main>
</div>

@code {
    private const float BaseSwitchThreshold = 15f;

    private IReadOnlyList<BaseView> _views = Array.Empty<BaseView>();
    private Vector2 _playerFlat;
    private long? _selectedBaseId;
    private long? _pinnedBaseId;

    // Which map's detail panel is open in column 3: "base", "drone", "vehicle", or null (= extractors)
    private string? _activeMap;

    // Recently-docked drones: held for 5 seconds after they leave the flying list
    private Dictionary<int, DroneData> _prevFlyingData = new();
    private Dictionary<int, (DroneData Drone, DateTime HidAt)> _recentlyDocked = new();

    private Timer? _timer;

    private BaseView? SelectedBase => _views.FirstOrDefault(b => b.Id == _selectedBaseId);

    private void SelectMap(string? map)
    {
        _activeMap = _activeMap == map ? null : map;
        if (_activeMap != "base") { _pinnedBaseId = null; UpdateSelection(); }
    }

    private void OnBaseMapClick()
    {
        // Empty-space click: toggle base panel (shows nearest when opening)
        SelectMap("base");
    }

    private void SelectBase(long id)
    {
        _activeMap = "base";
        _pinnedBaseId = _pinnedBaseId == id ? null : id;
        UpdateSelection();
    }

    private void UnpinBase()
    {
        _pinnedBaseId = null;
        UpdateSelection();
    }

    protected override void OnInitialized()
    {
        Live.Changed += OnChanged;
        World.Changed += OnChanged;
        Refresh();

        var wasRunning = Launcher.IsRunning();
        _timer = new Timer(_ =>
        {
            var now = Launcher.IsRunning();
            if (now != wasRunning) { wasRunning = now; _ = InvokeAsync(StateHasChanged); }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        var data = Live.Data;
        var bases = World.Bases.Bases;

        if (data?.Player?.Position is { } here)
            _playerFlat = new Vector2((float)here.X, (float)here.Z);

        if (data?.Player?.Position is not null && bases.Count > 0)
            _views = bases.Select(b => new BaseView(b, _playerFlat)).OrderBy(v => v.Distance).ToList();
        else
            _views = Array.Empty<BaseView>();

        // Track recently-docked drones
        var nowFlying = data?.Drones?.Flying ?? new List<DroneData>();
        var nowFlyingIds = nowFlying.Select(d => d.Id).ToHashSet();

        foreach (var (id, drone) in _prevFlyingData)
            if (!nowFlyingIds.Contains(id))
                _recentlyDocked.TryAdd(id, (drone, DateTime.UtcNow.AddSeconds(5)));

        var expired = _recentlyDocked.Where(kv => DateTime.UtcNow >= kv.Value.HidAt).Select(kv => kv.Key).ToList();
        foreach (var id in expired) _recentlyDocked.Remove(id);

        _prevFlyingData = nowFlying.ToDictionary(d => d.Id);

        UpdateSelection();
    }

    private void UpdateSelection()
    {
        if (_pinnedBaseId is long pin && _views.All(b => b.Id != pin))
            _pinnedBaseId = null;

        _selectedBaseId = _pinnedBaseId ?? BaseSelector.Choose(_views, _selectedBaseId, BaseSwitchThreshold);
    }

    private void LaunchGame() { Launcher.Launch(); StateHasChanged(); }

    public void Dispose()
    {
        Live.Changed -= OnChanged;
        World.Changed -= OnChanged;
        _timer?.Dispose();
    }

    private string BaseCountText()
    {
        var bases = World.Bases.Bases;
        return bases.Count == 0 ? "" : $"{bases.Count(b => b.Kind == BaseKind.Base)} bases, {bases.Count(b => b.Kind == BaseKind.Outpost)} outposts";
    }

    private static string BasesEmptyText(LiveStatus status, WorldData? world) =>
        world is null || !world.InWorld ? EmptyText(status) : "No bases found.";

    private static string StatusText(LiveStatus status, LiveData? data, bool running) => status switch
    {
        LiveStatus.Live => "LIVE",
        LiveStatus.Menu => "GAME AT THE MAIN MENU",
        LiveStatus.Stale when data is not null && running => "NO RECENT DATA FROM THE GAME",
        LiveStatus.Stale when data is not null => "GAME NOT RUNNING",
        _ => "WAITING FOR THE GAME"
    };

    private static string StatusSub(LiveStatus status, LiveData? data, bool running) => status switch
    {
        LiveStatus.Live => data?.Planet is null && data?.PlanetId is null ? "" : $"plugin {data!.PluginVersion}",
        LiveStatus.Menu => "load a world to see it here",
        LiveStatus.Stale when data?.UpdatedAt is { } at && running => $"last reading {at.ToLocalTime():HH:mm:ss}",
        LiveStatus.Stale when data?.UpdatedAt is { } at => $"showing last reading from {at.ToLocalTime():HH:mm:ss}",
        _ => "start Planet Crafter with the RRSOS PCC Live plugin"
    };

    private static string EmptyText(LiveStatus status) =>
        status == LiveStatus.Menu ? "No world loaded." : "Waiting for live data.";

    private static float Fraction(double? value, double? max, double? fallbackMax)
    {
        var top = max is > 0 ? max.Value : fallbackMax ?? 100;
        return value is null || top <= 0 ? 0f : (float)Math.Clamp(value.Value / top, 0, 1);
    }

    private static string Max(double? max) => max is null ? "100" : max.Value.ToString("0.#");
}
