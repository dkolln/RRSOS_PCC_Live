@* A small map of the extractors around you, you in the middle and the game's north up. Hover a pip for what it is
   (a native title tooltip); click it to see its contents. Click empty space to open the list, click it again to
   close. The caption below is always the total count and the distance/direction to the nearest one, like Drones. *@
<div class="extractor-map @(Open ? "is-open" : "") @(Dim ? "is-dim" : "")" @onclick="() => OnMapClick.InvokeAsync()">

    @if (Placed.Count == 0)
    {
        <div class="map-empty">@EmptyText</div>
    }
    else
    {
        <svg viewBox="0 0 140 140" role="group" aria-label="Map of the extractors around you">
            <defs>
                <linearGradient id="ext-cone-fade-@_uid" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0" stop-color="#7ab8ff" stop-opacity="0.6" />
                    <stop offset="1" stop-color="#7ab8ff" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="radar-sweep-fade-@_uid" gradientUnits="userSpaceOnUse" x1="70" y1="6" x2="111.15" y2="20.98">
                    <stop offset="0" stop-color="#4fd18b" stop-opacity="0" />
                    <stop offset="1" stop-color="#4fd18b" stop-opacity="0.95" />
                </linearGradient>
            </defs>

            <rect class="map-face" x="6" y="6" width="128" height="128" rx="6" />

            <circle class="map-ring-line" cx="70" cy="70" r="32" />
            <circle class="map-ring-line" cx="70" cy="70" r="64" />
            <line class="map-cross" x1="70" y1="6" x2="70" y2="134" />
            <line class="map-cross" x1="6" y1="70" x2="134" y2="70" />
            <text class="map-north" x="76" y="17">N</text>
            <text class="map-east" x="128" y="66">E</text>

            @* Where you are and which way you face *@
            <g class="map-turn" style="transform: rotate(@Inv($"{_turn:0.##}")deg)">
                <path d="M 70 70 L 57.26 38.47 A 34 34 0 0 1 82.74 38.47 Z" fill="url(#ext-cone-fade-@_uid)" />
            </g>
            <circle class="map-you" cx="70" cy="70" r="3.2" />

            @* The extractor being shown is drawn last so nothing sits on top of it. *@
            @foreach (var e in ShownExtractors.OrderBy(e => e.Id == SelectedId))
            {
                var (x, y) = Place(e.Position!);

                <g class="map-pip @(e.Id == SelectedId ? "selected" : "") @(Distance(e) > Range ? "far" : "")"
                   transform="translate(@Inv($"{x:0.##} {y:0.##}"))"
                   role="button" aria-label="@PipLabel(e)"
                   @onclick="() => OnSelect.InvokeAsync(e.Id)" @onclick:stopPropagation>
                    <title>@PipLabel(e)</title>
                    <circle class="map-hit" r="6" />
                    <circle class="map-dot" r="2.6" />
                    <circle class="map-select" r="6" />
                </g>
            }

            @* A fake radar sweep, purely decorative. Drawn last (on top of the pips) with mix-blend-mode:screen, so
               a pip only brightens for the instant the sweep's light is actually over it — real-time pixel
               compositing, not a pre-scheduled animation, so it can never drift out of sync as the player moves
               and pip positions shift underneath it. *@
            <g class="radar-sweep">
                <path d="M 70 70 L 70 6 A 64 64 0 0 1 111.15 20.98 Z" fill="url(#radar-sweep-fade-@_uid)" />
            </g>

            <text class="map-range" x="130" y="130">@Range m</text>
        </svg>

        <div class="zoom-controls">
            <button class="zoom-btn" type="button" title="Zoom in" @onclick="ZoomIn" @onclick:stopPropagation disabled="@(Range <= RangeSteps[0])">+</button>
            <button class="zoom-btn" type="button" title="Zoom out" @onclick="ZoomOut" @onclick:stopPropagation disabled="@(Range >= RangeSteps[^1])">&minus;</button>
            <button class="zoom-btn zoom-reset" type="button" title="Reset zoom" @onclick="ResetZoom" @onclick:stopPropagation disabled="@(_zoomIndex is null)">&times;</button>
        </div>

        <div class="map-label">Extractors</div>

        <div class="map-caption">
            <span class="map-caption-name">@Extractors.Count extractor@(Extractors.Count == 1 ? "" : "s")</span>
            <span class="map-caption-meta">@NearestText</span>
        </div>
    }
</div>

@code {
    private const float MapHalf = 64f;
    private static readonly int[] RangeSteps = { 10, 20, 40, 70, 100, 250, 500, 1000, 1500, 2000, 3000, 5000, 10000, 20000 };

    /// <summary>Every extractor the plugin found.</summary>
    [Parameter]
    public IReadOnlyList<ExtractorData> Extractors { get; set; } = Array.Empty<ExtractorData>();

    /// <summary>Where the player stands (raw world X, Z) and which way they face (compass degrees).</summary>
    [Parameter]
    public Vector2 PlayerFlat { get; set; }

    [Parameter]
    public float PlayerHeading { get; set; }

    /// <summary>The extractor the detail panel is showing.</summary>
    [Parameter]
    public long? SelectedId { get; set; }

    [Parameter]
    public EventCallback<long> OnSelect { get; set; }

    /// <summary>True when this map's detail panel is showing in the right column.</summary>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>Raised when the user clicks the map background (not a specific extractor pip).</summary>
    [Parameter]
    public EventCallback OnMapClick { get; set; }

    /// <summary>Drawn faded, when the reading is old.</summary>
    [Parameter]
    public bool Dim { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "no extractors";

    private IReadOnlyList<ExtractorData> Placed => Extractors.Where(e => e.Position is not null).ToList();

    // Only extractors inside the range are drawn (the rest are still found by walking towards them).
    private IEnumerable<ExtractorData> ShownExtractors => Placed.Where(e => Distance(e) <= Range);

    // The closest extractor to the player, regardless of the current zoom range.
    private ExtractorData? Nearest => Placed.OrderBy(Distance).FirstOrDefault();

    private string NearestText => Nearest is { } n
        ? $"{(int)Distance(n)} m {Compass.GetCompassDirection(PlayerFlat, Flat(n.Position!))}"
        : "none nearby";

    // Several of these share a page, and SVG ids are page-wide.
    private readonly string _uid = Guid.NewGuid().ToString("N")[..8];

    private float _heading;
    private float _turn;
    private bool _started;

    protected override void OnParametersSet()
    {
        var heading = float.IsFinite(PlayerHeading) ? PlayerHeading : 0f;

        if (!_started)
        {
            _started = true;
            _turn = heading;
        }
        else
        {
            // Turn by the shortest way round, so 359 to 2 degrees is a small nudge and not a full spin.
            _turn += ((heading - _heading + 540f) % 360f) - 180f;
        }

        _heading = heading;
    }

    private static Vector2 Flat(Vec3 position) => new((float)position.X, (float)position.Z);

    private float Distance(ExtractorData e) => Vector2.Distance(PlayerFlat, Flat(e.Position!));

    // The smallest round radius that still holds the farthest extractor.
    private int FitRange
    {
        get
        {
            var far = Placed.Count > 0 ? Placed.Max(Distance) * 1.08f : 0f;
            return RangeSteps.FirstOrDefault(step => far <= step, RangeSteps[^1]);
        }
    }

    // The map reaches half of the range that would fit every extractor, so the near ones are not squashed together.
    private int AutoRange => Math.Max(RangeSteps[0], FitRange / 2);

    // A manual override (an index into RangeSteps) from the zoom buttons, so extractors sitting right on top of
    // each other near the centre can be spread out enough to click. Null follows AutoRange; anything further out
    // than the zoomed-in range simply falls off the map's edge, which is fine.
    private int? _zoomIndex;

    private int Range => _zoomIndex is { } idx ? RangeSteps[idx] : AutoRange;

    private void ZoomIn()
    {
        var idx = _zoomIndex ?? IndexAtLeast(AutoRange);
        _zoomIndex = Math.Max(0, idx - 1);
    }

    private void ZoomOut()
    {
        var idx = _zoomIndex ?? IndexAtLeast(AutoRange);
        _zoomIndex = Math.Min(RangeSteps.Length - 1, idx + 1);
    }

    private void ResetZoom() => _zoomIndex = null;

    private static int IndexAtLeast(int value)
    {
        for (var i = 0; i < RangeSteps.Length; i++)
        {
            if (RangeSteps[i] >= value)
                return i;
        }

        return RangeSteps.Length - 1;
    }

    // You are at the centre and the game's north is up. Anything past the edge is pinned to it, on its bearing.
    private (float X, float Y) Place(Vec3 position)
    {
        var offset = Compass.ToEastNorth(Flat(position) - PlayerFlat) * (MapHalf / Range);
        var length = offset.Length();

        if (length > MapHalf)
            offset *= MapHalf / length;

        return (70f + offset.X, 70f - offset.Y);
    }

    private static string Title(ExtractorData e) => string.IsNullOrWhiteSpace(e.ProductName)
        ? Kind(e.Kind)
        : $"{Kind(e.Kind)} · {e.ProductName}";

    private static string Kind(string kind) => kind switch
    {
        "ore" => "Ore",
        "gas" => "Gas",
        "water" => "Water",
        "algae" => "Algae",
        _ => kind
    };

    private string PipLabel(ExtractorData e) =>
        $"{Title(e)}, {(int)Distance(e)} m {Compass.GetCompassDirection(PlayerFlat, Flat(e.Position!))}";

    private static string Inv(FormattableString s) => FormattableString.Invariant(s);
}
