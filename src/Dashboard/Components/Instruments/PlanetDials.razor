@* One dial per terraformation stat: how far it is from an equal share of the total. Under each: its total, what
   the launched rockets multiply it by, and its live rate. The rates come from the game, already including every machine and rocket. *@
<div class="ti @(Dim ? "is-dim" : "")">
    @if (Data is null || Categories.Count == 0)
    {
        <div class="ti-empty">no planet data</div>
    }
    else
    {
        <div class="ti-gauges">
            @foreach (var category in Categories)
            {
                var key = category.Name.ToLowerInvariant();
                Data.Rockets.TryGetValue(key, out var rocket);
                Data.Units.TryGetValue(key, out var unit);

                <div class="ti-gauge is-clickable @(category.Status == TiStatus.Idle ? "is-idle" : "")" title="@Tooltip(category) Click to see what makes it."
                     @onclick="() => OnSelect.InvokeAsync(category.Name)">
                    <Gauge Label="@category.Name"
                           Centered="true"
                           Value="@(category.Deviation / TiBalance.ScalePoints)"
                           Unknown="@(category.Status == TiStatus.Idle)"
                           StatusOverride="@StatusName(category.Status)"
                           DisplayText="@Signed(category.Deviation)"
                           MinLabel="@Scale("−")"
                           MaxLabel="@Scale("+")" />
                    <div class="ti-value">@Compass.Abbreviate(category.Value)</div>

                    @if (unit is not null)
                    {
                        <div class="ti-rate" title="Gained per second, as the game reports it">▲ @Compass.Abbreviate(unit.IncreasePerSec)/s</div>
                    }

                    @if (rocket is { Count: > 0 })
                    {
                        <div class="ti-rockets" title="@RocketTooltip(category.Name, rocket)">🚀 @rocket.Count · ×@rocket.Multiplier.ToString("0.##")</div>
                    }
                </div>
            }
        </div>

        <div class="ti-total">
            <span class="label">» Total TI</span>
            <span class="value">@Total.ToString("N0")</span>
        </div>
    }
</div>

@code {
    private static readonly string[] Names = { "Oxygen", "Heat", "Pressure", "Plants", "Insects", "Animals" };

    [Parameter]
    public PlanetData? Data { get; set; }

    /// <summary>Drawn faded, when the reading is old.</summary>
    [Parameter]
    public bool Dim { get; set; }

    /// <summary>Raised with the stat's name ("Oxygen") when its gauge is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    // Purification takes part in the balance (and the total) but has its dial on the Toxicity tab of the power card.
    private IReadOnlyList<TiCategory> Categories => TiBalance.ForPlanet(Data).Where(c => Names.Contains(c.Name)).ToList();

    private double Total => TiBalance.Total(Data);

    private static string? StatusName(TiStatus status) => TiBalance.StatusName(status);

    private static string Signed(float deviation) => TiBalance.Signed(deviation);

    private static string Scale(string sign) => sign + TiBalance.ScalePoints.ToString("0");

    private static string Tooltip(TiCategory category) => TiBalance.Tooltip(category);

    private static string RocketTooltip(string stat, RocketData rocket) =>
        $"{stat}: {rocket.Count} rocket(s) launched, so {stat.ToLowerInvariant()} generation is x{rocket.Multiplier:0.##} " +
        "what the machines alone would make (the game's own figure).";
}
