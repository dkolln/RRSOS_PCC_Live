@inject FactoryService Svc
@inject BuildTemplateStore Templates
@inject ToastService Toasts
@inject IJSRuntime JS

<section class="fc">
    <h2>Factory</h2>
    <p class="hint">
        Autocrafters on a floor @FactoryService.Height.ToString("0") m above the warehouse, one per platform, each set to make one product from the warehouse chests inside its
        range (the game's autocrafter reaches @RangeText, in a sphere). Each product's finished items are supplied to the drones, so the warehouse chest that demands it is
        filled; a crafter stops by itself when its 8 output slots are full. A sign on each crafter says what it makes. When no single platform reaches every ingredient, the
        crafter gets a local <strong>Container1</strong> beside it (outlined in yellow on the plan) demanding the rest at high priority, the same fallback as a hand-built one.
        A product that still has nowhere to go gets a corner of its own on a platform nothing else claimed (shown in purple), up to 4 sharing one platform this way.
        Everything faces and runs the way the warehouse's beacon points. Building writes into the save (with a backup first), so do it with the game at the main menu.
    </p>

    @if (string.IsNullOrEmpty(SavePath))
    {
        <p class="hint">Choose a save above.</p>
    }
    else if (_book is null)
    {
        <p class="fc-problem">
            No <code>recipes.json</code> yet. It is written by plugin 0.9.0 or later, once per game session, after a world loads: start the game with that plugin, load any
            world, wait a few seconds, then come back here.
        </p>
    }
    else if (_template is null)
    {
        <p class="fc-problem">The factory is planned over a Container3 warehouse. Capture a Container3 template in Base Building first.</p>
    }
    else if (_beacons.Count == 0)
    {
        <p class="hint">No warehouse beacon in this save. Build the warehouse first (a beacon named <code>All</code>, Base Building tab).</p>
    }
    else
    {
        <div class="fc-controls">
            <label>Warehouse beacon
                <select @onchange="OnBeacon">
                    @foreach (var b in _beacons)
                    {
                        <option value="@b.Id" selected="@(b.Id == _beaconId)">@b.Text (points @Compass(b), at @b.X.ToString("0"), @((-b.Z).ToString("0")))</option>
                    }
                </select>
            </label>
            <label class="fc-option">
                <input type="checkbox" checked="@_on" @onchange="e => _on = e.Value is true" />
                Build the crafters switched on (recipe set)
            </label>
        </div>

        @if (_screen is null)
        {
            <p class="hint">Working out the plan…</p>
        }
        else if (_screen.Problems.Count > 0)
        {
            @foreach (var p in _screen.Problems)
            {
                <p class="fc-problem">@p</p>
            }
        }
        else
        {
            var plan = _screen.Plan;
            var laid = plan.Floor.Count(c => c.Laid);

            <h3>Products</h3>
            <div class="fc-controls">
                <input class="fc-filter" placeholder="filter by name or id" value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" />
                <label class="fc-option">
                    <input type="checkbox" checked="@_onlyReach" @onchange="e => _onlyReach = e.Value is true" />
                    only show the ones in reach
                </label>
                <button class="bar-btn" @onclick="SelectReachable">Tick all in reach</button>
                <button class="bar-btn" @onclick="SelectAll">Tick all</button>
                <button class="bar-btn" @onclick="SelectNone">Tick none</button>
                <span class="fc-muted">@_selected.Count ticked, @_screen.Reaches.Count(r => r.Mode == FactoryMode.InRange) of @_screen.Reaches.Count in reach</span>
            </div>

            <div class="fc-list">
                <table class="fc-table">
                    <thead><tr><th></th><th>Product</th><th>Made at</th><th>Needs</th><th>Reach</th></tr></thead>
                    <tbody>
                        @foreach (var r in VisibleReaches())
                        {
                            <tr class="@(r.Mode == FactoryMode.InRange ? "" : "is-out")" @key="r.Product">
                                <td><input type="checkbox" checked="@_selected.Contains(r.Product)" @onchange="e => Toggle(r.Product, e.Value is true)" /></td>
                                <td><strong>@Svc.NameOf(r.Product)</strong> <span class="fc-muted">@r.Product</span></td>
                                <td class="fc-muted">@PlaceOf(r.Product)</td>
                                <td class="fc-muted">@Needs(r)</td>
                                <td>@if (r.Mode == FactoryMode.InRange) { <span class="fc-ok">in reach, @r.BestFarthest.ToString("0.0") m</span> } else { <span class="fc-warn">@r.Note</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3>Plan</h3>
            <p class="fc-summary">
                <strong>@plan.Crafters</strong> crafters on <strong>@laid</strong> platforms (@plan.Floor.Count in the floor), each with a sign.
                <span class="fc-warn-strong">Once switched on they draw about @((plan.PowerKw / 1000).ToString("0.0")) MW (@plan.Crafters x @Svc.CrafterKw.ToString("0") kW).</span>
            </p>

            @foreach (var c in plan.Floor.Where(c => c.Conflicts.Count > 0).Take(6))
            {
                <p class="fc-problem">Platform @c.Index is not clear: @string.Join(", ", c.Conflicts)</p>
            }

            @if (plan.NotBuilt.Count > 0)
            {
                <details class="fc-notbuilt" open>
                    <summary>Ticked, but not built (@plan.NotBuilt.Count)</summary>
                    @foreach (var n in plan.NotBuilt)
                    {
                        <div class="fc-muted"><strong>@Svc.NameOf(n.Product)</strong> (@n.Product): @n.Note</div>
                    }
                </details>
            }

            <svg class="fc-svg" viewBox="@ViewBox(plan)" xmlns="http://www.w3.org/2000/svg">
                @foreach (var c in plan.Floor)
                {
                    <rect x="@Sx(c.Z + Half(plan))" y="@Sy(c.X + Half(plan))" width="@Num(Spacing(plan))" height="@Num(Spacing(plan))"
                          class="fc-cell @CellClass(c)"><title>@CellTitle(c)</title></rect>
                }
                <circle cx="@Sx(plan.Beacon.Z)" cy="@Sy(plan.Beacon.X)" r="0.9" class="fc-beacon" />
            </svg>

            <div class="fc-actions">
                <button class="resupply-btn" disabled="@(!CanBuild(plan))" @onclick="Build">@(_busy ? "WORKING..." : "BUILD FACTORY")</button>
                @if (GameLive)
                {
                    <span class="fc-problem">The game is running a world. Exit to the main menu first.</span>
                }
            </div>

            <h3>Crafters standing now</h3>
            @if (_screen.Crafters.Count == 0)
            {
                <p class="hint">None on the factory floor yet.</p>
            }
            else
            {
                <div class="fc-actions">
                    <button class="bar-btn" disabled="@(_busy || GameLive)" @onclick="() => SetPower(true, null)">ALL ON</button>
                    <button class="bar-btn" disabled="@(_busy || GameLive)" @onclick="() => SetPower(false, null)">ALL OFF</button>
                    <span class="fc-muted">
                        @_screen.Crafters.Count(c => c.On) on, @_screen.Crafters.Count(c => !c.On) off
                        (@((_screen.Crafters.Count(c => c.On) * Svc.CrafterKw / 1000).ToString("0.0")) MW while on)
                    </span>
                </div>
                <div class="fc-list">
                    <table class="fc-table">
                        <thead><tr><th>Product</th><th>State</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in _screen.Crafters)
                            {
                                <tr @key="c.Id">
                                    <td><strong>@(string.IsNullOrEmpty(c.Product) ? "(no product set)" : Svc.NameOf(c.Product))</strong> <span class="fc-muted">@c.Product · @c.X.ToString("0"), @((-c.Z).ToString("0"))</span></td>
                                    <td>@if (c.On) { <span class="fc-ok">on</span> } else { <span class="fc-muted">off</span> }</td>
                                    <td>
                                        <button class="bar-btn" disabled="@(_busy || GameLive || string.IsNullOrEmpty(c.Product))" @onclick="() => SetPower(!c.On, c.Id)">@(c.On ? "Switch off" : "Switch on")</button>
                                        <button class="bar-btn is-danger-text" disabled="@(_busy || GameLive)" @onclick="() => RemoveCrafter(c)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_removed.Count > 0)
            {
                <h3>Recently removed</h3>
                <p class="hint">Add one straight back into the exact spot it stood in (the platform, or the same corner if it was sharing one).</p>
                <div class="fc-list">
                    <table class="fc-table">
                        <thead><tr><th>Product</th><th>Spot</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _removed)
                            {
                                <tr @key="@($"{r.Product}-{r.X}-{r.Z}")">
                                    <td><strong>@Svc.NameOf(r.Product)</strong> <span class="fc-muted">@r.Product</span></td>
                                    <td class="fc-muted">@r.X.ToString("0"), @((-r.Z).ToString("0"))</td>
                                    <td>
                                        <button class="bar-btn" disabled="@(_busy || GameLive)" @onclick="() => AddBack(r)">Add back here</button>
                                        <button class="bar-btn" disabled="@_busy" @onclick="() => _removed.Remove(r)">Dismiss</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <h3>Ramps</h3>
            <p class="hint">
                BUILD FACTORY always lays both ways down to the warehouse too: the east ramp along the row nearest the beacon, and the back ramp down the far column (the
                11th), reproduced exactly from the owner's own build. Both only ever touch the factory floor's tiles; the warehouse underneath stays flat. Use these if one
                needs fixing up on its own (after a hand edit, say) — each is safe to run again and leaves an already-correct ramp untouched.
            </p>
            <div class="fc-actions">
                <button class="bar-btn" disabled="@(_busy || GameLive)" @onclick="() => BuildRamp(true)">Fix east ramp</button>
                <button class="bar-btn" disabled="@(_busy || GameLive)" @onclick="() => BuildRamp(false)">Fix back ramp</button>
            </div>

            @if (_screen.Removal.Any)
            {
                var rem = _screen.Removal;
                <h3>Remove factory</h3>
                <p class="fc-summary">
                    A factory stands here: <strong>@rem.Foundations</strong> platforms, <strong>@rem.Crafters</strong> crafters, <strong>@(rem.Chests - rem.Crafters)</strong> chests and
                    <strong>@rem.Signs</strong> signs, with <strong>@rem.Items</strong> items in them. Removing deletes exactly those (and the inventories), nothing else.
                </p>
                @if (rem.Blockers.Count > 0)
                {
                    <p class="fc-problem">Something else stands in it (@string.Join("; ", rem.Blockers)). Take it away first.</p>
                }
                <button class="resupply-btn is-danger" disabled="@(_busy || GameLive || rem.Blockers.Count > 0)" @onclick="Remove">@(_busy ? "WORKING..." : "REMOVE FACTORY")</button>
            }
        }

        @if (_message is not null)
        {
            <p class="@(_ok ? "fc-ok" : "fc-problem")">@_message</p>
        }
    }
</section>

@code {
    [Parameter] public string SavePath { get; set; } = "";

    /// <summary>True while the game has a world loaded: the save would only be overwritten.</summary>
    [Parameter] public bool GameLive { get; set; }

    private string _loadedFor = "";
    private RecipeBook? _book;
    private BuildTemplate? _template;
    private IReadOnlyList<BuildBeacon> _beacons = Array.Empty<BuildBeacon>();
    private long _beaconId;
    private FactoryScreen? _screen;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string _filter = "";
    private bool _onlyReach;
    // The floor is always laid in full (2026-09-27, the owner: "looks better that way").
    private const bool _fullFloor = true;
    private bool _on = true;
    private bool _busy;
    private string? _message;
    private bool _ok;

    private string RangeText => Svc.Book()?.AutoCrafter?.Range is { } r ? r.ToString("0") + " m" : "20 m";

    protected override async Task OnParametersSetAsync()
    {
        if (SavePath == _loadedFor)
            return;

        _loadedFor = SavePath;
        _screen = null;
        _beaconId = 0;
        _book = Svc.Book();
        _template = (await Templates.LoadAsync()).FirstOrDefault(t => t.Slots >= 80);
        _beacons = string.IsNullOrEmpty(SavePath) || !File.Exists(SavePath) ? Array.Empty<BuildBeacon>() : await Svc.WarehouseBeaconsAsync(SavePath);

        // Everything ticked by default (2026-09-27, the owner: "I'll uncheck as I see fit"), once we know what the game can make.
        if (_selected.Count == 0 && _book is not null)
            foreach (var r in _book.Buildable())
                _selected.Add(r.Id);

        if (_beacons.Count > 0)
        {
            _beaconId = _beacons[0].Id;
            await Replan();
        }
    }

    private async Task OnBeacon(ChangeEventArgs e)
    {
        _beaconId = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await Replan();
    }

    private async Task Toggle(string product, bool on)
    {
        if (on) _selected.Add(product); else _selected.Remove(product);
        await Replan();
    }

    private async Task SelectReachable()
    {
        _selected.Clear();
        foreach (var r in _screen?.Reaches.Where(r => r.Mode == FactoryMode.InRange) ?? Enumerable.Empty<ProductReach>())
            _selected.Add(r.Product);
        await Replan();
    }

    private async Task SelectAll()
    {
        _selected.Clear();
        foreach (var r in _screen?.Reaches ?? Enumerable.Empty<ProductReach>())
            _selected.Add(r.Product);
        await Replan();
    }

    private async Task SelectNone()
    {
        _selected.Clear();
        await Replan();
    }

    private async Task Replan()
    {
        var beacon = _beaconId;
        if (_book is null || _template is null || beacon == 0 || string.IsNullOrEmpty(SavePath))
            return;

        var screen = await Svc.LoadAsync(SavePath, beacon, _template, _book, _selected.ToList(), _fullFloor);
        if (beacon == _beaconId)
            _screen = screen;
    }

    private bool CanBuild(FactoryBuildPlan plan) => !_busy && !GameLive && plan.Ok;

    private async Task Build()
    {
        if (_screen is null || _book is null || _template is null || !CanBuild(_screen.Plan))
            return;

        var plan = _screen.Plan;
        var localChests = plan.Floor.Count(c => c.LocalChestItems is { Count: > 0 });
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Have you exited to the Main Menu?\n\nBUILD FACTORY adds {plan.Floor.Count(c => c.Laid && !c.FoundationExists)} foundations, {plan.Crafters} crafters, {plan.Crafters} signs" +
            (localChests > 0 ? $" and {localChests} local input chests (for products no single platform reaches in full)" : "") + " to your save file.\n\n" +
            $"POWER: once switched on, {plan.Crafters} crafters draw about {(plan.PowerKw / 1000):0.0} MW ({FactoryService.DefaultCrafterKw:0} kW each). " +
            (_on ? "They are being built switched ON." : "They are being built switched OFF.") +
            "\n\nIf a world is still loaded, the game will overwrite the change at its next autosave.");

        if (!confirmed)
            return;

        await Run(async () =>
        {
            var edit = await Svc.BuildAsync(SavePath, _beaconId, _template, _book, _selected.ToList(), _fullFloor, _on);
            if (!edit.Success || edit.Result is null)
                return (false, edit.Error ?? "The build failed.");

            var r = edit.Result;
            return (true, $"Built {r.Foundations} foundations (including the ramp tiles), {r.Chests - r.LocalChests} crafters, {r.LocalChests} local input chests and {r.Signs} signs. Backup: {edit.BackupPath}");
        });
    }

    private async Task Remove()
    {
        if (_screen is null || _template is null || _busy || GameLive)
            return;

        var rem = _screen.Removal;
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Have you exited to the Main Menu?\n\nREMOVE FACTORY deletes {rem.Foundations} platforms, {rem.Crafters} crafters, {rem.Chests - rem.Crafters} chests, {rem.Signs} signs and {rem.Items} items from your save file, and whatever is in those chests goes with them. A backup is made first, and that is the only way back.");

        if (!confirmed)
            return;

        await Run(async () =>
        {
            var edit = await Svc.RemoveAsync(SavePath, _beaconId, _template);
            if (!edit.Success || edit.Result is null)
                return (false, edit.Error ?? "The removal failed.");

            var p = edit.Result.Plan;
            return (true, $"Removed {p.Foundations} platforms, {p.Crafters} crafters, {p.Signs} signs and {p.Items} items. Backup: {edit.BackupPath}");
        });
    }

    /// <summary>A crafter just removed, kept client-side only, so "Add back here" can put one back in that exact spot without hunting for a platform again.</summary>
    private readonly List<(string Product, double X, double Z)> _removed = new();

    private async Task RemoveCrafter(FactoryCrafter c)
    {
        if (_busy || GameLive || string.IsNullOrEmpty(c.Product))
            return;

        await Run(async () =>
        {
            var edit = await Svc.RemoveCrafterAsync(SavePath, c.Id);
            if (!edit.Success)
                return (false, edit.Error ?? "Could not remove that crafter.");

            _removed.Add((c.Product, c.X, c.Z));
            return (true, "Removed the crafter, its sign and its local chest (if it had one). Backup: " + edit.BackupPath);
        });
    }

    private async Task AddBack((string Product, double X, double Z) r)
    {
        if (_book is null || _template is null || _busy || GameLive)
            return;

        await Run(async () =>
        {
            var edit = await Svc.AddCrafterAtAsync(SavePath, _beaconId, _template, _book, r.X, r.Z, r.Product, _on);
            if (!edit.Success || edit.Result is null)
                return (false, edit.Error ?? "Could not add that crafter back.");

            _removed.Remove(r);
            return (true, $"Added {Svc.NameOf(r.Product)} back at {r.X:0}, {-r.Z:0}. Backup: {edit.BackupPath}");
        });
    }

    private async Task BuildRamp(bool east)
    {
        if (_template is null || _busy || GameLive)
            return;

        await Run(async () =>
        {
            var edit = await Svc.BuildRampAsync(SavePath, _beaconId, _template, east);
            if (!edit.Success || edit.Result is null)
                return (false, edit.Error ?? "Could not build that ramp.");

            var r = edit.Result;
            return (true, $"{(east ? "East" : "Back")} ramp: removed {r.Removed} tile(s), added {r.Added}. Backup: {edit.BackupPath}");
        });
    }

    private async Task SetPower(bool on, long? id)
    {
        if (_book is null || _template is null || _busy || GameLive)
            return;

        await Run(async () =>
        {
            var edit = await Svc.SetPowerAsync(SavePath, _beaconId, _template, _book, on, id);
            if (!edit.Success || edit.Result is null)
                return (false, edit.Error ?? "Could not switch the crafters.");

            return (true, $"Switched {edit.Result.Changed} crafter(s) {(on ? "on" : "off")}. Backup: {edit.BackupPath}");
        });
    }

    private async Task Run(Func<Task<(bool Ok, string Message)>> work)
    {
        _busy = true;
        _message = null;
        StateHasChanged();

        try
        {
            (_ok, _message) = await work();
            Toasts.Show(_message.Length > 120 ? _message[..120] + "…" : _message, _ok ? ToastKind.Success : ToastKind.Error, TimeSpan.FromSeconds(_ok ? 5 : 9));
            _screen = null;
            await Replan();
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<ProductReach> VisibleReaches()
    {
        if (_screen is null)
            return Enumerable.Empty<ProductReach>();

        var filter = _filter.Trim();
        return _screen.Reaches
            .Where(r => !_onlyReach || r.Mode == FactoryMode.InRange)
            .Where(r => filter.Length == 0 || r.Product.Contains(filter, StringComparison.OrdinalIgnoreCase) || Svc.NameOf(r.Product).Contains(filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => Svc.NameOf(r.Product), StringComparer.OrdinalIgnoreCase);
    }

    private string Needs(ProductReach r) =>
        string.Join(", ", r.Ingredients.Select(i => (i.Value > 1 ? i.Value + " " : "") + Svc.NameOf(i.Key)));

    private string PlaceOf(string id)
    {
        var recipe = _book?.Recipes.GetValueOrDefault(id);
        var place = recipe?.CraftableIn.FirstOrDefault(c => c is "CraftStationT1" or "CraftStationT2" or "CraftStationT3" or "CraftOvenT1" or "CraftQuartzT1" or "CraftBioLab" or "CraftDroneT1" or "CraftToxicRefinementT1");
        return place switch
        {
            "CraftStationT1" => "craft station 1",
            "CraftStationT2" => "craft station 2",
            "CraftStationT3" => "craft station 3",
            "CraftOvenT1" => "oven",
            "CraftQuartzT1" => "quartz station",
            "CraftBioLab" => "bio lab",
            "CraftDroneT1" => "drone crafter",
            "CraftToxicRefinementT1" => "toxic refinery",
            _ => ""
        };
    }

    // North is +x and east is -z in the save; the drawing has north up and east to the right.
    private static string Compass(BuildBeacon b) => (b.DirX, b.DirZ) switch
    {
        (1, _) => "north",
        (-1, _) => "south",
        (_, 1) => "west",
        _ => "east"
    };

    private static double Spacing(FactoryBuildPlan plan) => plan.Floor.Count > 1 ? Math.Round(Math.Min(
        plan.Floor.Select(c => c.X).Distinct().OrderBy(x => x).Zip(plan.Floor.Select(c => c.X).Distinct().OrderBy(x => x).Skip(1), (a, b) => b - a).DefaultIfEmpty(6).Min(),
        plan.Floor.Select(c => c.Z).Distinct().OrderBy(z => z).Zip(plan.Floor.Select(c => c.Z).Distinct().OrderBy(z => z).Skip(1), (a, b) => b - a).DefaultIfEmpty(6).Min()), 2) : 6;

    private static double Half(FactoryBuildPlan plan) => Spacing(plan) / 2;
    private static string Num(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string Sx(double z) => Num(-z);
    private static string Sy(double x) => Num(-x);

    private static string ViewBox(FactoryBuildPlan plan)
    {
        if (plan.Floor.Count == 0)
            return "0 0 10 10";

        var h = Half(plan);
        double left = -(plan.Floor.Max(c => c.Z) + h) - 1, right = -(plan.Floor.Min(c => c.Z) - h) + 1;
        double top = -(plan.Floor.Max(c => c.X) + h) - 1, bottom = -(plan.Floor.Min(c => c.X) - h) + 1;
        return $"{Num(left)} {Num(top)} {Num(right - left)} {Num(bottom - top)}";
    }

    private static string CellClass(FactoryFloorCell c) =>
        (c.Conflicts.Count > 0 ? "is-blocked " : "")
        + (c.Product is not null ? "is-crafter" : c.Quarters is { Count: > 0 } ? "is-quartered" : c.Laid ? "is-laid" : "is-empty")
        + (c.FoundationExists ? " is-there" : "")
        + (c.LocalChestItems is { Count: > 0 } || (c.Quarters?.Any(q => q.LocalChestItems is { Count: > 0 }) ?? false) ? " has-local-chest" : "");

    private string CellTitle(FactoryFloorCell c)
    {
        if (c.Quarters is { Count: > 0 } tenants)
            return string.Join("; ", tenants.Select(t => $"{Svc.NameOf(t.Product)} ({t.Product}), farthest chest {t.Farthest:0.0} m"
                + (t.LocalChestItems is { Count: > 0 } m ? $" + a local chest demanding {string.Join(", ", m.Select(Svc.NameOf))}" : "")));

        if (c.Product is null)
            return c.Laid ? "bare foundation" : "not laid";

        return c.LocalChestItems is { Count: > 0 } missing
            ? $"{Svc.NameOf(c.Product)} ({c.Product}), farthest chest {c.Farthest:0.0} m + a local chest demanding {string.Join(", ", missing.Select(Svc.NameOf))}"
            : $"{Svc.NameOf(c.Product)} ({c.Product}), farthest chest {c.Farthest:0.0} m";
    }
}
