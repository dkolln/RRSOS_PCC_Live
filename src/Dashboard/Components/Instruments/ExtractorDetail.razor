@* What one extractor holds: kind/product, position, how full it is, and its contents. The extractor equivalent of
   BaseContents — reached by clicking a pip on ExtractorMap. *@
<div class="ext-detail @(Dim ? "is-dim" : "")">

    <div class="ext-detail-title">
        <span class="ext-detail-name">@Title</span>
        <span class="ext-detail-meta">@WhereText</span>
        <span class="ext-detail-spacer"></span>
        <button class="ext-detail-btn" @onclick="OnBack">← All extractors</button>
    </div>

    <div class="ext-detail-pos">@PositionText</div>

    <div class="ext-detail-fill" title="@FillText">
        <div class="ext-detail-fill-bar @(IsFull ? "is-full" : "")" style="width: @Inv($"{FillFraction * 100:0.#}")%"></div>
        <span class="ext-detail-fill-text">@FillText</span>
    </div>

    @if (Data.Items.Count == 0)
    {
        <div class="ext-detail-empty">No contents.</div>
    }
    else
    {
        <div class="ext-detail-items">
            @foreach (var item in Data.Items.OrderBy(i => i.Label, StringComparer.CurrentCultureIgnoreCase))
            {
                <div class="ext-detail-line">
                    <span class="ext-detail-line-name">@item.Label</span>
                    <span class="ext-detail-line-count">@item.Count@(Data.Kind == "algae" && item.Ready > 0 ? $" ({item.Ready} ready)" : "")</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public ExtractorData Data { get; set; } = null!;

    /// <summary>Where the player stands (raw world X, Z). Without it, distance and direction are left out.</summary>
    [Parameter]
    public Vector2? PlayerFlat { get; set; }

    /// <summary>Drawn faded, when the reading is old.</summary>
    [Parameter]
    public bool Dim { get; set; }

    /// <summary>Raised by "All extractors", to go back to the list.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private string Title => string.IsNullOrWhiteSpace(Data.ProductName) ? Kind(Data.Kind) : $"{Kind(Data.Kind)} · {Data.ProductName}";

    private static string Kind(string kind) => kind switch
    {
        "ore" => "Ore",
        "gas" => "Gas",
        "water" => "Water",
        "algae" => "Algae",
        _ => kind
    };

    private Vector2? Flat => Data.Position is { } p ? new Vector2((float)p.X, (float)p.Z) : null;

    private string PositionText => Flat is { } f ? Inv($"X {f.X:F0}   Z {f.Y:F0}") : "";

    private string WhereText => PlayerFlat is { } here && Flat is { } there
        ? $"{(int)Vector2.Distance(here, there)} m {Compass.GetCompassDirection(here, there)}"
        : "";

    private int Have => Data.Kind == "algae" ? Data.Ready : Data.Count;

    private bool IsFull => Data.Size > 0 && Have >= Data.Size;

    private float FillFraction => Data.Size > 0 ? Math.Clamp((float)Have / Data.Size, 0f, 1f) : 0f;

    private string FillText => Data.Size > 0 ? $"{Have} / {Data.Size}{(Data.Kind == "algae" ? " grown" : "")}" : $"{Have}";

    private static string Inv(FormattableString s) => FormattableString.Invariant(s);
}
