@inject IconCatalog Icons
@inject IJSRuntime JS

@* Power straight from the game: what is produced and used, with a picture per generator. *@
<div class="power @(Dim ? "is-dim" : "")">
    <div class="power-title">
        <button type="button" class="power-tab @(ShowToxicity ? "" : "is-on")" @onclick="() => ChooseTab(Tab.Power)">Power</button>
        @if (HasToxicity)
        {
            <button type="button" class="power-tab @(ShowToxicity ? "is-on" : "")" @onclick="() => ChooseTab(Tab.Toxicity)">Toxicity</button>
        }

        @* The other tab's headline, so it never goes out of sight. *@
        @if (ShowToxicity && Data is not null)
        {
            <button type="button" class="power-aside power-figure @FigureClass" @onclick="() => ChooseTab(Tab.Power)" title="Power: @FigureLabel. Click to show Power.">
                <span class="lbl">@FigureLabel</span> <span class="num">@Kw(Math.Abs(Data.ProducedKw - Data.UsedKw))</span>
            </button>
        }
        else if (!ShowToxicity && NeedsPurification)
        {
            <button type="button" class="power-aside" @onclick="() => ChooseTab(Tab.Toxicity)" title="Purification. Click to show Toxicity.">
                <span class="lbl">Purification</span> <span class="num">@Compass.Abbreviate(Purification!.Value)</span>
            </button>
        }
    </div>

    @if (ShowToxicity)
    {
        <div class="tox-main">
            @if (PurificationCategory is { } category)
            {
                @* Same dial as the other terraformation stats: how far Purification is from an equal share of the total. *@
                <div class="tox-gauge is-clickable" title="@TiBalance.Tooltip(category) Click to see what makes it."
                     @onclick="() => OnSelect.InvokeAsync(category.Name)">
                    <Gauge Label="Purification"
                           Centered="true"
                           Value="@(category.Deviation / TiBalance.ScalePoints)"
                           Unknown="@(category.Status == TiStatus.Idle)"
                           StatusOverride="@TiBalance.StatusName(category.Status)"
                           DisplayText="@TiBalance.Signed(category.Deviation)"
                           MinLabel="@("−" + TiBalance.ScalePoints.ToString("0"))"
                           MaxLabel="@("+" + TiBalance.ScalePoints.ToString("0"))" />
                    <div class="tox-value">@Compass.Abbreviate(category.Value)</div>
                    @if (PurificationUnit is { } unit)
                    {
                        <div class="tox-sub" title="Gained per second, as the game reports it">▲ @Compass.Abbreviate(unit.IncreasePerSec)/s</div>
                    }
                </div>
            }

            <div class="tox-bars" title="@CleanupTitle">
                @if (Toxicity is { TotalObjects: > 0 } t)
                {
                    <div class="tox-bar">
                        <div class="tox-bar-head"><span class="tox-bar-label"><Icon Id="ToxicGoo" Size="1.1rem" />Goo collected</span><span>@t.CleanedObjects / @t.TotalObjects</span></div>
                        <div class="tox-bar-track"><div class="tox-bar-fill @BarState(t.CleanedObjects, t.TotalObjects)" style="width: @Pct(t.CleanedObjects, t.TotalObjects)"></div></div>
                    </div>
                    <div class="tox-bar">
                        <div class="tox-bar-head"><span>Areas cleaned</span><span>@t.CleanedAreas / @t.TotalAreas</span></div>
                        <div class="tox-bar-track"><div class="tox-bar-fill @BarState(t.CleanedAreas, t.TotalAreas)" style="width: @Pct(t.CleanedAreas, t.TotalAreas)"></div></div>
                    </div>
                }
                else
                {
                    <div class="power-empty">no cleanup reading yet</div>
                }
            </div>
        </div>
    }
    else if (Data is null)
    {
        <div class="power-empty">no data</div>
    }
    else
    {
        <div class="power-main">
            <div class="power-meter">
                <Gauge Label="Power load"
                       Value="@Load"
                       Unknown="@(Data.ProducedKw <= 0)"
                       DisplayText="@LoadText"
                       MaxLabel="@Compass.Abbreviate(Data.ProducedKw)"
                       HigherIsWorse="true"
                       WarnAt="0.75f"
                       CritAt="0.9f" />

                <div class="power-figure @FigureClass">
                    <span class="num">@Kw(Math.Abs(Data.ProducedKw - Data.UsedKw))</span>
                    <span class="lbl">@FigureLabel</span>
                </div>

                <div class="power-detail">
                    <span class="power-produced" title="Power being produced">▲ @Kw(Data.ProducedKw)</span>
                    <span class="power-used" title="Power being used">▼ @Kw(Data.UsedKw)</span>
                </div>
            </div>

            <div class="power-icons" title="@IconsTitle">
                @foreach (var (icon, id, idx) in SortedIcons)
                {
                    @* The machine's own icon from the game when the plugin has written it; the drawn picture otherwise. *@
                    @if (Icons.Has(id))
                    {
                        <Icon Id="@id" Size="1.9rem" />
                    }
                    else
                    {
                        <PowerIcon Kind="@icon" Index="@idx" />
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private const int MaxIconsPerGroup = 40;

    private static readonly Dictionary<string, (string Icon, string Name)> Known = new(StringComparer.OrdinalIgnoreCase)
    {
        ["EnergyGenerator1"] = ("windmill", "Wind Turbine"),
        ["EnergyGenerator2"] = ("sun",      "Solar Panel T1"),
        ["EnergyGenerator3"] = ("sun-large","Solar Panel T2"),
        ["EnergyGenerator4"] = ("atom",     "Nuclear Reactor T1"),
        ["EnergyGenerator5"] = ("atoms",    "Nuclear Reactor T2"),
        ["EnergyGenerator6"] = ("starburst","Fusion Generator")
    };

    private static readonly string[] TypeOrder = { "windmill", "sun", "sun-large", "atom", "atoms", "starburst", "bolt" };

    [Parameter]
    public PlanetData? Planet { get; set; }

    [Parameter]
    public bool Dim { get; set; }

    private enum Tab { Power, Toxicity }

    private const string TabKey = "pcc.powerCardTab";

    private Tab _tab = Tab.Power;

    // The pick is kept in this browser, so a page refresh (or the card being rebuilt when the data goes away and comes back) lands on the same tab.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            if (await JS.InvokeAsync<string?>("localStorage.getItem", TabKey) == "toxicity")
            {
                _tab = Tab.Toxicity;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // No storage (a private window) or the circuit is gone: stay on Power.
        }
    }

    private async Task ChooseTab(Tab tab)
    {
        _tab = tab;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", TabKey, tab == Tab.Toxicity ? "toxicity" : "power");
        }
        catch (Exception)
        {
            // This visit only.
        }
    }

    private PowerData? Data => Planet?.Power;

    private UnitData? PurificationUnit => Planet is not null && Planet.Units.TryGetValue("purification", out var u) ? u : null;

    // The game parks purification at -1 on a planet that does not need it.
    private double? Purification => PurificationUnit is { Value: >= 0 } u ? u.Value : null;

    private bool NeedsPurification => Purification is not null;

    private ToxicityData? Toxicity => Planet?.Toxicity;

    private bool HasToxicity => NeedsPurification || Toxicity is { TotalAreas: > 0 };

    private bool ShowToxicity => _tab == Tab.Toxicity && HasToxicity;

    // Purification is one of the stats Terraformation adds up, so it is balanced against the others like they are.
    private TiCategory? PurificationCategory => TiBalance.ForPlanet(Planet).FirstOrDefault(c => c.Name == "Purification");

    /// <summary>Raised with the stat's name ("Purification") when its dial is clicked.</summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    // The same zones the gauges use for a stat where more is better: red under a fifth, yellow under half, green from half up.
    private const float BarCritAt = 0.2f;
    private const float BarWarnAt = 0.5f;

    private static string BarState(int done, int total)
    {
        var fraction = total <= 0 ? 0f : Math.Clamp(done / (float)total, 0f, 1f);
        return fraction < BarCritAt ? "is-crit" : fraction < BarWarnAt ? "is-warn" : "is-good";
    }

    private static string Pct(int done, int total) =>
        total <= 0 ? "0%" : (Math.Clamp(done / (double)total, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private string CleanupTitle => Toxicity is { TotalObjects: > 0 } t
        ? $"Cleanup: {t.CleanedObjects} of {t.TotalObjects} toxic objects cleaned, {t.CleanedAreas} of {t.TotalAreas} areas fully clean. This is the game's Toxicity screen."
        : "Cleanup: no toxic areas read yet (needs plugin 0.14.0 and a loaded world).";

    private bool Short => Data is not null && Data.UsedKw > Data.ProducedKw;
    private float Load => Data is null || Data.ProducedKw <= 0 ? 0f : (float)Math.Clamp(Data.UsedKw / Data.ProducedKw, 0, 1);
    private string LoadText => Data is null || Data.ProducedKw <= 0 ? "--" : $"{Data.UsedKw / Data.ProducedKw:P0}";

    private string FigureClass => Short ? "deficit" : Load >= 0.75f ? "reserve" : "surplus";
    private string FigureLabel => Short ? "Deficit" : Load >= 0.75f ? "Reserve" : "Surplus";

    private sealed record Group(string Id, string Icon, int Count, string Title);

    private IEnumerable<Group> Groups => Data is null
        ? Enumerable.Empty<Group>()
        : Data.Generators.Select(g =>
        {
            var known = Known.TryGetValue(g.Id, out var k);
            return new Group(g.Id, known ? k.Icon : "bolt", g.Count, $"{(known ? k.Name : g.Id)} ×{g.Count}: {Kw(g.Kw)}");
        });

    // Weakest generator first, as before; a kind the table does not know goes last.
    private IEnumerable<(string Icon, string Id, int Index)> SortedIcons
    {
        get
        {
            var idx = 0;
            foreach (var group in Groups.OrderBy(g => Array.IndexOf(TypeOrder, g.Icon)).ThenBy(g => g.Id, StringComparer.Ordinal))
                for (var i = 0; i < Math.Min(group.Count, MaxIconsPerGroup); i++)
                    yield return (group.Icon, group.Id, idx++);
        }
    }

    private string IconsTitle => string.Join(", ", Groups.Select(g => g.Title));

    private static string Kw(double kw) => $"{kw:N1} kW";
}
