@* What one base holds: everything stored in it (by name), crops ready to harvest, and loose items on the ground. Each list is open on load, shows
   10 rows and then scrolls; click its title to fold it away. Ported from RRSOS-PCC's Base Contents card. *@
<div class="contents @(Dim ? "is-dim" : "")">

    @if (SelectedBase is null)
    {
        <div class="contents-empty">@EmptyText</div>
    }
    else
    {
        var info = SelectedBase.Info;

        <div class="contents-title">
            <span class="contents-name">@SelectedBase.Name</span>
            <span class="contents-meta">@SelectedBase.DisplayDistance @SelectedBase.Direction · @(SelectedBase.Kind == BaseKind.Outpost ? "outpost" : "base")</span>
            <span class="contents-spacer"></span>

            @if (IsPinned)
            {
                <button class="contents-btn" @onclick="OnFollowNearest" title="Go back to showing the nearest base">🔒 Follow nearest</button>
            }
            else
            {
                <span class="contents-meta">nearest</span>
            }
        </div>

        @if (info.Stored.Count == 0 && info.Ready.Count == 0 && info.Loose.Count == 0)
        {
            <div class="contents-empty">Nothing stored here.</div>
        }

        <div class="contents-lists">
            @if (info.Stored.Count > 0)
            {
                <div class="contents-list"><ItemList Title="Stored" Data="@ByName(info.Stored)" Columns="1" MaxRows="10" Collapsible="true" /></div>
            }

            <div class="contents-pair">
                @if (info.Ready.Count > 0)
                {
                    <div class="contents-list ready"><ItemList Title="Ready to harvest" Data="@ByName(info.Ready)" Columns="1" MaxRows="10" Collapsible="true" /></div>
                }

                @if (info.Loose.Count > 0)
                {
                    <div class="contents-list loose"><ItemList Title="@BoneyardTitle" Data="@ByName(info.Loose)" Columns="1" MaxRows="10" Collapsible="true" /></div>
                }
            </div>

            <BaseFloorPlan Plan="@info.Plan" BaseId="@info.Id" PlayerPosition="@PlayerPosition"
                           PlayerHeading="@PlayerHeading" Dim="@Dim" EmptyText="@PlanEmptyText" />
        </div>
    }
</div>

@code {
    /// <summary>The base being shown, or null when there are none.</summary>
    [Parameter]
    public BaseView? SelectedBase { get; set; }

    /// <summary>True when the base was picked by hand, false when it is simply the nearest one.</summary>
    [Parameter]
    public bool IsPinned { get; set; }

    /// <summary>Raised when the user drops a pinned base and goes back to following the nearest.</summary>
    [Parameter]
    public EventCallback OnFollowNearest { get; set; }

    /// <summary>Drawn faded, when the reading is old.</summary>
    [Parameter]
    public bool Dim { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "No bases found.";

    /// <summary>Where the player is (raw world X, Y, Z) and which way they face, for the floor plan. Null when unknown.</summary>
    [Parameter]
    public Vector3? PlayerPosition { get; set; }

    [Parameter]
    public float PlayerHeading { get; set; }

    /// <summary>When the save the boneyard was read from was written (local time). Null before one has been read.</summary>
    [Parameter]
    public DateTime? BoneyardSavedAt { get; set; }

    // The boneyard comes from the last save, not live, so its title says how fresh it is.
    private string BoneyardTitle => BoneyardSavedAt is { } at ? $"Boneyard (save {at:HH:mm})" : "Boneyard (loose)";

    /// <summary>What the floor plan says when there is nothing to draw (an older plugin writes no building pieces).</summary>
    [Parameter]
    public string PlanEmptyText { get; set; } = "No building pieces reported for this base.";

    private static InventoryData ByName(IReadOnlyList<ItemCount> items) => new()
    {
        Items = items.Select(i => new ItemData { Id = i.Id, Name = i.Name, Count = i.Count }).ToList()
    };
}
