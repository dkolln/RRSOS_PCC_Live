@inject BaseBuildingService Building
@inject BuildTemplateStore Templates
@inject ItemCatalog Catalog
@inject ToastService Toasts
@inject WorldFileService World
@inject PlanetNames Planets
@inject IJSRuntime JS

<section class="bb">
    <h2>Base Building</h2>
    <p class="hint">
        Place a foundation with a <strong>beacon</strong> on it, named for what the row is for (like <code>Fish</code>), turned to point
        the way the row should grow. Save, then pick it here: the row is built from the platform the beacon points at, out in that
        direction, one platform per template, each chest labelled with the next item of the recipe. Building writes the
        foundations and chests into the save (with a backup first), so do it with the game at the main menu.
    </p>

    @if (string.IsNullOrEmpty(SavePath))
    {
        <p class="hint">Choose a save above.</p>
    }
    else if (_error is not null)
    {
        <p class="bb-problem">@_error</p>
    }
    else
    {
        <div class="bb-cols">

            <div class="bb-col">
                <h3>Templates</h3>
                @if (_templates.Count == 0)
                {
                    <p class="hint">
                        None yet. Build a sample once (a beacon pointing at a platform that carries the chests you want, and nothing else on
                        it), save, and capture it below. Keep the sample in the game until it is captured.
                    </p>
                }

                @foreach (var t in _templates)
                {
                    <div class="bb-card" @key="t.Name">
                        <div class="bb-card-head">
                            <strong>@t.Name</strong>
                            <span class="bb-muted">@t.ChestGId · @t.Slots slots · @t.Chests.Count per platform · @t.Spacing m</span>
                            <button class="bar-btn" title="Forget this template" @onclick="() => DeleteTemplate(t)">×</button>
                        </div>
                        <div class="bb-muted">
                            @string.Join("  ", t.Chests.Select((c, i) => $"{i + 1}: ({c.Dx:0.#}, {c.Dz:0.#})"))
                        </div>
                    </div>
                }
            </div>

            <div class="bb-col">
                <h3>Beacons in this save</h3>
                @if (_beacons.Count == 0)
                {
                    <p class="hint">No named beacons found.</p>
                }
                else if (_beacons.GroupBy(b => b.Text, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
                {
                    <p class="hint">
                        Some beacons share a name (one for each base, say@(_beacons.Select(b => b.PlanetHash).Distinct().Count() > 1 ? ", or one per planet" : "")).
                        Pick the one you mean: a row is only ever built from the one beacon you pick, near the base shown@(_beacons.Select(b => b.PlanetHash).Distinct().Count() > 1 ? ", on the planet shown" : "").
                    </p>
                }

                @foreach (var b in _beacons)
                {
                    <div class="bb-card @(b.Id == _beaconId ? "is-picked" : "")" @key="b.Id">
                        <div class="bb-card-head">
                            <label class="bb-pick">
                                <input type="radio" name="beacon" checked="@(b.Id == _beaconId)" @onchange="() => PickBeacon(b)" />
                                <strong>@b.Text</strong>
                                @if (PlanetLabel(b) is { Length: > 0 } planet)
                                {
                                    <span class="bb-planet">@planet</span>
                                }
                            </label>
                            <span class="bb-muted">points @Compass(b) · @NearBase(b) · @(b.FoundationId is null ? "not on a foundation" : "on a foundation")</span>
                            <button class="bar-btn" title="Read the platform this beacon points at and keep it as a template" @onclick="() => Capture(b)">Capture template</button>
                        </div>
                        <div class="bb-muted">north @b.X.ToString("0.#") · east @((-b.Z).ToString("0.#")) · yaw @b.YawDegrees.ToString("0")°</div>
                    </div>
                }

                @if (_captureMessage is not null)
                {
                    <p class="@(_captureOk ? "bb-ok" : "bb-problem")">@_captureMessage</p>
                }
            </div>

        </div>

        @if (_beaconId != 0 && _templates.Count > 0)
        {
            <h3>Plan</h3>
            <div class="bb-controls">
                <label>Recipe
                    <select @onchange="OnRecipe">
                        @foreach (var r in _recipes)
                        {
                            <option value="@r.Key" selected="@(r.Key == _recipeKey)">@r.Name (@r.ChestCount@(r.Bundles is null ? "" : " chests"))</option>
                        }
                    </select>
                </label>
                <label>Template
                    <select @onchange="OnTemplate">
                        @foreach (var t in ValidTemplates)
                        {
                            <option value="@t.Name" selected="@(t.Name == _templateName)">@t.Name</option>
                        }
                    </select>
                </label>
            </div>

            @if (IsWarehouse && ValidTemplates.Count == 0)
            {
                <p class="bb-problem">The warehouse is built from Container3 only (80 slots). Capture a Container3 template first.</p>
            }

            @if (CurrentRecipe is { MinSlots: > 0, Warehouse: false } stocked)
            {
                <p class="hint">
                    This group is stocked, one of each item in a chest, so only templates whose chests hold at least @stocked.MinSlots items are offered
                    (Container2 or Container3).
                </p>

                @if (ValidTemplates.Count == 0)
                {
                    <p class="bb-problem">No stored template has @stocked.MinSlots slots. Capture a Container2 or Container3 template first.</p>
                }
            }

            @if (_plan is null)
            {
                <p class="hint">Working out the plan…</p>
            }
            else if (_plan.Problems.Count > 0)
            {
                @foreach (var p in _plan.Problems)
                {
                    <p class="bb-problem">@p</p>
                }
            }
            else
            {
                var spare = _plan.ChestCount - _plan.Labelled;

                <p class="bb-summary">
                    <strong>@_plan.Platforms.Count</strong> platforms going @Compass(_plan.Beacon), <strong>@_plan.ChestCount</strong> chests,
                    <strong>@_plan.Labelled</strong> labelled@(spare > 0 ? $", {spare} spare (left unlabelled)" : "").
                    @if (_plan.Platforms.Any(p => p.FoundationExists))
                    {
                        <span class="bb-muted"> Foundations already there: @string.Join(", ", _plan.Platforms.Where(p => p.FoundationExists).Select(p => p.Index)).</span>
                    }
                </p>

                @foreach (var p in _plan.Platforms.Where(p => p.Conflicts.Count > 0))
                {
                    <p class="bb-problem">Platform @p.Index is not clear: @string.Join(", ", p.Conflicts)</p>
                }

                <svg class="bb-svg" viewBox="@ViewBox(_plan)" xmlns="http://www.w3.org/2000/svg">
                    <rect x="@Sx(_plan.Beacon.FoundationZ + _plan.Template.Spacing / 2)" y="@Sy(_plan.Beacon.FoundationX + _plan.Template.Spacing / 2)"
                          width="@Num(_plan.Template.Spacing)" height="@Num(_plan.Template.Spacing)" class="bb-found is-start" />
                    <circle cx="@Sx(_plan.Beacon.Z)" cy="@Sy(_plan.Beacon.X)" r="0.6" class="bb-beacon" />

                    @foreach (var p in _plan.Platforms)
                    {
                        <rect x="@Sx(p.Z + _plan.Template.Spacing / 2)" y="@Sy(p.X + _plan.Template.Spacing / 2)"
                              width="@Num(_plan.Template.Spacing)" height="@Num(_plan.Template.Spacing)"
                              class="bb-found @(p.FoundationExists ? "is-there" : "is-new") @(p.Group == "(filler)" ? "is-filler" : "") @(p.Conflicts.Count > 0 ? "is-blocked" : "")"><title>@(p.Group is null ? "" : $"Row {p.Row}: {p.Group}")</title></rect>

                        @foreach (var c in p.Chests)
                        {
                            <rect x="@Sx(c.Z + 0.5)" y="@Sy(c.X + 0.5)" width="1" height="1" class="bb-chest @(c.Label is null && c.Title is null ? "is-spare" : "")">
                                <title>@(c.Label is not null ? c.Label + " (" + Catalog.NameOf(c.Label) + ")" : c.Title is not null ? c.Title + " (" + (c.Stock?.Count ?? 0) + " items" + (c.FillWith is null ? "" : " + " + c.FillWith + " to capacity") + ")" : "spare chest")</title>
                            </rect>
                        }
                    }
                </svg>

                <details class="bb-labels">
                    <summary>The labels, platform by platform</summary>
                    @foreach (var p in _plan.Platforms)
                    {
                        <div class="bb-muted">@(p.Row > 0 ? $"Row {p.Row}, " : "")Platform @p.Index@(p.Group is null ? "" : $" ({p.Group})"): @(p.Group == "(filler)" ? "bare foundation" : "")@string.Join(", ", p.Chests.Select(c => c.Label ?? (c.Title is null ? "(spare)" : $"{c.Title} ({c.Stock?.Count ?? 0}{(c.FillWith is null ? "" : " + " + c.FillWith + " to capacity")})")))</div>
                    }
                </details>

                @if (IsWarehouse)
                {
                    <p class="hint">
                        The whole warehouse, from this beacon (Container3 only): the first row of groups runs out from the platform the beacon points at, and each next row is
                        beside it on the beacon's right hand, with a blank aisle of bare foundations on the beacon's left and another after the last row. Every group starts
                        on a platform of its own, and short rows end in bare foundations. The first chests of each row carry index signs. The DNA and Genetics chests are
                        holding tanks: titled, but with no filter or demand. <strong>Only buildings are checked for room, not the ground</strong>, so make sure the whole
                        footprint is clear and flat. The equipment chests are stocked as they are built.
                    </p>
                }

                @if (CurrentRecipe?.Bundles is null)
                {
                <label class="bb-option">
                    <input type="checkbox" checked="@_setDemand" @onchange="e => _setDemand = e.Value is true" />
                    Also set each labelled chest to demand its item (so the drones fill it)
                </label>
                <label class="bb-option">
                    <input type="checkbox" checked="@_fill" @onchange="e => _fill = e.Value is true" />
                    Also fill each labelled chest to capacity with its item (@(_plan.Template.Slots > 0 ? _plan.Template.Slots : 15) each, @FillItems(_plan) items)
                </label>
                }
                else
                {
                    <p class="hint">A stocked group is filled as it is built (one of each item, and the token box to capacity); the demand and fill options do not apply.</p>
                }

                <button class="resupply-btn" disabled="@(!CanBuild)" @onclick="Build">
                    @(_busy ? "BUILDING..." : BuildWord)
                </button>
                @if (GameLive)
                {
                    <p class="bb-problem">The game is running a world. Exit to the main menu first.</p>
                }
                @if (_buildMessage is not null)
                {
                    <p class="@(_buildOk ? "bb-ok" : "bb-problem")">@_buildMessage</p>
                }
            }

            @if (IsWarehouse && _removal is { Any: true } removal)
            {
                <h3>Remove warehouse</h3>
                <p class="bb-summary">
                    A warehouse stands here: <strong>@removal.Foundations</strong> platforms, <strong>@removal.Chests</strong> chests and
                    <strong>@removal.Items</strong> items in them@(removal.Signs > 0 ? $", and {removal.Signs} signs on them" : ""). Removing it deletes exactly those (and the chests' inventories), nothing else.
                </p>

                @if (removal.Blockers.Count > 0)
                {
                    <p class="bb-problem">Something else stands in it (@string.Join("; ", removal.Blockers)). Take it away first; nothing is removed while it is there.</p>
                }

                <button class="resupply-btn is-danger" disabled="@(!CanRemove)" @onclick="RemoveWarehouse">
                    @(_busy ? "WORKING..." : "REMOVE WAREHOUSE")
                </button>
                @if (GameLive)
                {
                    <p class="bb-problem">The game is running a world. Exit to the main menu first.</p>
                }
            }

            @if (_removeMessage is not null)
            {
                <p class="@(_removeOk ? "bb-ok" : "bb-problem")">@_removeMessage</p>
            }
        }
    }
</section>

@code {
    [Parameter] public string SavePath { get; set; } = "";

    /// <summary>True while the game has a world loaded: the save would only be overwritten.</summary>
    [Parameter] public bool GameLive { get; set; }

    private bool _setDemand = true;
    private bool _fill;
    private bool _busy;
    private string? _buildMessage;
    private bool _buildOk;

    private BuildRecipe? CurrentRecipe => _recipes.FirstOrDefault(x => x.Key == _recipeKey);

    // The stored templates a group can use: for a stocked group only those whose chests hold everything in the biggest bundle.
    private List<BuildTemplate> ValidTemplates => _templates.Where(t => t.Slots >= (CurrentRecipe?.MinSlots ?? 0)).ToList();

    private BaseBuildingEngine.RemovalPlan? _removal;
    private string? _removeMessage;
    private bool _removeOk;

    private bool CanRemove => !_busy && !GameLive && _removal is { Any: true, Blockers.Count: 0 };

    private bool IsWarehouse =>CurrentRecipe is { Warehouse: true };

    private string BuildWord => IsWarehouse ? "BUILD WAREHOUSE" : "BUILD ROW";

    // Items a fill would write: one chest's worth for each labelled chest (the stocked chests of the equipment group are filled as they are built).
    private static int FillItems(BuildPlan plan) => plan.Platforms.Sum(p => p.Chests.Count(c => c.Label is not null)) * (plan.Template.Slots > 0 ? plan.Template.Slots : 15);

    private bool CanBuild =>!_busy && !GameLive && _plan is { Ok: true, Platforms.Count: > 0 };

    private string _loadedFor = "";
    private string? _error;
    private IReadOnlyList<BuildBeacon> _beacons = Array.Empty<BuildBeacon>();
    private List<BuildTemplate> _templates = new();
    private IReadOnlyList<BuildRecipe> _recipes = Array.Empty<BuildRecipe>();
    private long _beaconId;
    private string _templateName = "";
    private string _recipeKey = "";
    private BuildPlan? _plan;
    private string? _captureMessage;
    private bool _captureOk;

    protected override async Task OnParametersSetAsync()
    {
        if (SavePath == _loadedFor)
            return;

        _loadedFor = SavePath;
        _beaconId = 0;
        _plan = null;
        _captureMessage = null;
        _error = null;
        _recipes = Building.Recipes();
        _templates = await Templates.LoadAsync();
        _templateName = _templates.FirstOrDefault()?.Name ?? "";

        if (string.IsNullOrEmpty(SavePath) || !File.Exists(SavePath))
        {
            _beacons = Array.Empty<BuildBeacon>();
            return;
        }

        var (beacons, error) = await Building.ScanAsync(SavePath);
        _beacons = beacons;
        _error = error;

        if (_beacons.Count == 1)
            await PickBeacon(_beacons[0]);
    }

    private async Task PickBeacon(BuildBeacon b)
    {
        _beaconId = b.Id;
        _recipeKey = Building.RecipeFor(b.Text)?.Key ?? _recipes.FirstOrDefault()?.Key ?? "";
        await Replan();
    }

    private async Task OnRecipe(ChangeEventArgs e)
    {
        _recipeKey = e.Value?.ToString() ?? "";
        await Replan();
    }

    private async Task OnTemplate(ChangeEventArgs e)
    {
        _templateName = e.Value?.ToString() ?? "";
        await Replan();
    }

    private async Task Replan()
    {
        _plan = null;
        var recipe = CurrentRecipe;

        // Switch to a template that is big enough when the group needs one.
        if (recipe is not null && !ValidTemplates.Any(t => t.Name == _templateName))
            _templateName = ValidTemplates.FirstOrDefault()?.Name ?? _templateName;

        var template = ValidTemplates.FirstOrDefault(t => t.Name == _templateName);

        if (_beaconId == 0 || template is null || recipe is null)
            return;

        var beacon = _beaconId;
        var plan = await Building.PlanAsync(SavePath, beacon, template, recipe);
        var removal = recipe.Warehouse ? await Building.WarehouseScanAsync(SavePath, beacon, template) : null;

        if (beacon == _beaconId)
        {
            _plan = plan;
            _removal = removal;
        }
    }

    private async Task RemoveWarehouse()
    {
        var template = ValidTemplates.FirstOrDefault(t => t.Name == _templateName);
        if (!CanRemove || template is null || _removal is null)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Have you exited to the Main Menu?\n\nREMOVE WAREHOUSE deletes {_removal.Foundations} platforms, {_removal.Chests} chests, {_removal.Signs} signs and {_removal.Items} items from your save file, and whatever is in those chests goes with them. A backup is made first, and that is the only way back. If a world is still loaded, the game will overwrite the change at its next autosave.");

        if (!confirmed)
            return;

        _busy = true;
        _removeMessage = null;
        StateHasChanged();

        try
        {
            var edit = await Building.RemoveWarehouseAsync(SavePath, _beaconId, template);

            if (!edit.Success || edit.Result is null)
            {
                _removeOk = false;
                _removeMessage = edit.Error ?? "The removal failed.";
                Toasts.Show("Removing the warehouse failed. " + _removeMessage, ToastKind.Error, TimeSpan.FromSeconds(9));
            }
            else
            {
                var p = edit.Result.Plan;
                _removeOk = true;
                _removeMessage = $"Removed {p.Foundations} platforms, {p.Chests} chests, {p.Signs} signs and {p.Items} items. Backup: {edit.BackupPath}";
                Toasts.Show($"Removed {p.Foundations} platforms and {p.Chests} chests", ToastKind.Success);
            }

            _loadedFor = ""; // read the save again: the warehouse is gone from it
            await OnParametersSetAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Capture(BuildBeacon b)
    {
        var result = await Building.CaptureAsync(SavePath, b.Id, "");

        if (result.Template is null)
        {
            _captureOk = false;
            _captureMessage = string.Join(" ", result.Problems);
            return;
        }

        var template = result.Template with { Name = result.Template.ChestGId };
        await Templates.SaveAsync(template);
        _templates = await Templates.LoadAsync();
        _templateName = template.Name;
        _captureOk = true;
        _captureMessage = $"Captured \"{template.Name}\": {template.Chests.Count} {template.ChestGId} of {template.Slots} slots per platform, platforms {template.Spacing} m apart.";
        Toasts.Show(_captureMessage, ToastKind.Success);
        await Replan();
    }

    private async Task Build()
    {
        var template = ValidTemplates.FirstOrDefault(t => t.Name == _templateName);
        var recipe = CurrentRecipe;
        if (!CanBuild || template is null || recipe is null || _plan is null)
            return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Have you exited to the Main Menu?\n\n{BuildWord} adds {_plan.Platforms.Count(p => !p.FoundationExists)} foundations, {_plan.ChestCount} chests and {_plan.Platforms.Sum(p => p.Signs?.Count ?? 0)} signs{(_fill ? $" and {FillItems(_plan)} items" : "")} to your save file. If a world is still loaded, the game will overwrite the change at its next autosave.");

        if (!confirmed)
            return;

        _busy = true;
        _buildMessage = null;
        StateHasChanged();

        try
        {
            var edit = await Building.BuildAsync(SavePath, _beaconId, template, recipe, _setDemand, _fill);

            if (!edit.Success || edit.Result is null)
            {
                _buildOk = false;
                _buildMessage = edit.Error ?? "The build failed.";
                Toasts.Show("Base building failed. " + _buildMessage, ToastKind.Error, TimeSpan.FromSeconds(9));
            }
            else
            {
                _buildOk = true;
                _buildMessage = $"Built: {edit.Result.Foundations} foundations, {edit.Result.Chests} chests and {edit.Result.Signs} signs ({edit.Result.Labelled} labelled{(edit.Result.Items > 0 ? $", filled with {edit.Result.Items} items" : "")}). Backup: {edit.BackupPath}";
                Toasts.Show($"Built {edit.Result.Foundations} foundations and {edit.Result.Chests} chests", ToastKind.Success);
            }

            _loadedFor = ""; // read the save again: the row is in it now
            await OnParametersSetAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteTemplate(BuildTemplate t)
    {
        await Templates.DeleteAsync(t.Name);
        _templates = await Templates.LoadAsync();
        _templateName = _templates.FirstOrDefault()?.Name ?? "";
        await Replan();
    }

    // The base a beacon belongs to, by the dashboard's own rule (the nearest base within 100 m), from the last world file it read.
    // World.Bases only ever holds the planet currently loaded in the game, so a beacon on any other planet is left out here
    // (by coordinates alone, a beacon on Humble could sit "near" a base that is really on Prime, purely by chance).
    private string NearBase(BuildBeacon b)
    {
        if (World.Data is { } data && data.PlanetHash != 0 && b.PlanetHash != 0 && data.PlanetHash != b.PlanetHash)
            return "on another planet";

        var near = World.Bases.Bases
            .Select(x => (Base: x, Distance: Math.Sqrt(Math.Pow(x.Flat.X - b.X, 2) + Math.Pow(x.Flat.Y - b.Z, 2))))
            .Where(t => t.Distance <= BaseDirectory.OwnershipRadius)
            .OrderBy(t => t.Distance)
            .FirstOrDefault();

        return near.Base is null ? "no known base within 100 m" : $"near {near.Base.Name} ({near.Distance:0} m)";
    }

    // The beacon's planet, when planets.json (plugin 0.10.3+) has learned a name for its hash; blank otherwise (an
    // older save, or a planet not yet visited with the new plugin).
    private string PlanetLabel(BuildBeacon b) => Planets.NameOf(b.PlanetHash) ?? "";

    // North is +x and east is -z in the save; a beacon or row pointing +x points north.
    private static string Compass(BuildBeacon b) => (b.DirX, b.DirZ) switch
    {
        (1, _) => "north",
        (-1, _) => "south",
        (_, 1) => "west",
        _ => "east"
    };

    // Plan drawing: north up, east right, in metres. x (north) runs up and z (east is -z) runs across.
    private static string Num(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string Sx(double z) => Num(-z);
    private static string Sy(double x) => Num(-x);

    private static string ViewBox(BuildPlan plan)
    {
        var s = plan.Template.Spacing;
        var xs = plan.Platforms.Select(p => p.X).Append(plan.Beacon.FoundationX).ToList();
        var zs = plan.Platforms.Select(p => p.Z).Append(plan.Beacon.FoundationZ).ToList();
        double left = -(zs.Max() + s / 2) - 1, right = -(zs.Min() - s / 2) + 1;
        double top = -(xs.Max() + s / 2) - 1, bottom = -(xs.Min() - s / 2) + 1;
        return $"{Num(left)} {Num(top)} {Num(right - left)} {Num(bottom - top)}";
    }
}
