{
  // Every setting this dashboard reads. Blank means "work it out", which is right on a normal Steam install on any PC.
  // To change one for this PC only, put it in appsettings.Local.json beside this file (git ignores that file), or pass
  // it on the command line: dotnet run --project src/Dashboard -- --LiveFolder="D:\somewhere".

  "Urls": "http://localhost:5320",

  // Where the plugin writes its files, and where this dashboard keeps its own (base names, notes, resupply
  // configs, save backups). Default: %LOCALAPPDATA%\RRSOS-PCC-Live of the user who runs the game.
  "LiveFolder": "",

  // The plugin's two files and the base names, one by one (each defaults to LiveFolder). Setting LiveFile alone moves
  // everything beside it, which is how tools\sample-live.ps1 and tools\save-to-world.ps1 data is shown.
  "LiveFile": "",
  "WorldFile": "",
  "BaseData": "",

  // The game's save folder, for the Cheats page. Default: %USERPROFILE%\AppData\LocalLow\MijuGames\Planet Crafter.
  "SaveSettings": {
    "SavePath": ""
  },

  // How LAUNCH PC starts the game, and the process name that means it is running.
  // Defaults: steam://rungameid/1284190 and "Planet Crafter".
  "Game": {
    "LaunchUri": "",
    "ProcessName": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
