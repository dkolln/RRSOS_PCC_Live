<Project>

  <!-- Per-machine overrides (game folder). Optional: the default below is the usual Steam location. -->
  <Import Project="$(MSBuildThisFileDirectory)solution_private.targets" Condition="Exists('$(MSBuildThisFileDirectory)solution_private.targets')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Planet Crafter\</GameDir>
    <GameManaged>$(GameDir)Planet Crafter_Data\Managed\</GameManaged>
    <PluginsFolder>$(GameDir)BepInEx\plugins\</PluginsFolder>
  </PropertyGroup>

</Project>
